NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional server-only key for future automations. Do not expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Transactional email delivery (Resend). The sending domain must be verified
# in Resend before using info@projectedge.hu as the sender.
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=ProjectEdge Studio <info@projectedge.hu>
RESEND_REPLY_TO=info@projectedge.hu
# Internal destination for admin notifications; defaults to RESEND_REPLY_TO.
RESEND_NOTIFICATION_EMAIL=info@projectedge.hu
NEXT_PUBLIC_SITE_URL=https://www.projectedge.hu

# Stripe — kizárólag szerveroldali éles kulcsok. A webhook titka nem azonos
# az API secret key-jel; a Stripe Workbench webhook végpontjánál kapod meg.
STRIPE_SECRET_KEY=sk_live_xxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxx

# Éles rendszerpróba: egy Stripe kupon azonosítója (nem a promóciós kód!).
# Ha ki van töltve, az ADMIN felhasználó checkoutja ezzel a kedvezménnyel indul,
# így néhány száz forintból végigfut a valódi lánc (kártya → webhook → Billingo).
# Ügyfélre soha nem vonatkozik. A próba után TÖRÖLD — nem üzemszerű beállítás.
STRIPE_TEST_COUPON=

# Billingo V3 API (opcionális, de az automatikus AAM számlázáshoz szükséges).
# Nem a Billingónak átadott Stripe-kulcs: Billingo → Beállítások → API kulcsok.
BILLINGO_API_KEY=
BILLINGO_DOCUMENT_BLOCK_ID=
BILLINGO_BANK_ACCOUNT_ID=

# A napi Stripe-egyeztetés (/api/stripe/reconcile) védelme. A Vercel a cron
# hívásoknál ezt küldi `Authorization: Bearer ...` fejlécként. Generálj hosszú,
# véletlen értéket; enélkül a cron 401-et kap.
CRON_SECRET=

# ── Mérés és hirdetés (opcionális) ───────────────────────────────────────
# FONTOS: ezek `NEXT_PUBLIC_` változók, tehát BUILD IDŐBEN épülnek bele a
# kódba. Ha a Vercelen beállítod őket, attól még NEM lépnek életbe — kell egy
# új deploy (üres commit is elég), különben a régi build fut tovább nélkülük.
#
# A süti-banner a gyakorlatban mindig megjelenik, mert az ADS_ID-nak beégetett
# alapértéke van a lib/analytics.ts-ben (lásd az ottani kommentet).

# Google Analytics 4 mérőazonosító (Adminisztráció → Adatfolyamok)
NEXT_PUBLIC_GA_ID=

# Google Ads konverziós azonosító (Eszközök → Konverziók → Címke beállítása)
NEXT_PUBLIC_ADS_ID=

# A konverziós művelet címkéje (az AW-.../ utáni rész)
NEXT_PUBLIC_ADS_LEAD_LABEL=

# Microsoft Clarity projektazonosító — hőtérkép és munkamenet-visszajátszás.
# A clarity.microsoft.com → Settings → Overview alatt látod, illetve a
# telepítési kódban a "clarity", "script", "IDE_JÖN_AZ_ID" utolsó paramétere.
#
# Két feltétel kell ahhoz, hogy a Clarity adatot lásson:
#   1. ez a változó ki van töltve ÉS azóta volt új deploy;
#   2. a látogató elfogadta a statisztikai sütiket a bannerben — a session
#      replay hozzájárulás nélkül nem indulhat (lásd Adatkezelési tájékoztató).
# Ezért a Clarity szándékosan csak a látogatók egy részét látja.
NEXT_PUBLIC_CLARITY_ID=
